---
import '../styles/global.css';
import Header from '../components/Header.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'RANT',
  description = 'A lightweight, self-hosted source of truth for physical network infrastructure: racks, devices, ports, and cables.',
} = Astro.props;

const pageTitle = title === 'RANT' ? 'RANT - Rack And Networking Tool' : `${title} | RANT`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/primary-horizontal-bg.png', Astro.site).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{pageTitle}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={Astro.url.href} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- Cloudflare Web Analytics --><script type='module' src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "324032e804f64831b99a370ea2cc0983"}'></script><!-- End Cloudflare Web Analytics -->
  </head>
  <body>

    <Header />

    <slot />

    <footer class="site-footer">
      <div class="container">
        <div class="footer-inner">
          <div class="footer-brand">
            <img src="/primary-horizontal.png" alt="RANT" />
            <p>A lightweight, self-hosted source of truth for physical network infrastructure.</p>
          </div>

          <div class="footer-links">
            <h4>Project</h4>
            <ul>
              <li><a href="https://github.com/fluffycheese/rant" target="_blank" rel="noopener noreferrer">GitHub Repository</a></li>
              <li><a href="https://github.com/fluffycheese/rant/issues" target="_blank" rel="noopener noreferrer">Report an Issue</a></li>
              <li><a href="https://github.com/fluffycheese/rant/blob/main/docs/USER-GUIDE.md" target="_blank" rel="noopener noreferrer">User Guide</a></li>
            </ul>
          </div>

          <div class="footer-links">
            <h4>Site</h4>
            <ul>
              <li><a href="/#features">Features</a></li>
              <li><a href="/#compare">Compare</a></li>
              <li><a href="/#deploy">Deploy</a></li>
              <li><a href="/blog">Blog</a></li>
              <li><a href="/privacy">Privacy Policy</a></li>
            </ul>
          </div>
        </div>

        <div class="footer-bottom">
          <span>&copy; {new Date().getFullYear()} RANT. Open source, AGPL-3.0 License.</span>
          <span>Built with <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a>.</span>
        </div>
      </div>
    </footer>

    <script is:inline>
      const toggle = document.getElementById('menuToggle');
      const nav    = document.getElementById('navLinks');
      toggle.addEventListener('click', () => {
        const open = nav.classList.toggle('is-open');
        toggle.setAttribute('aria-expanded', String(open));
      });
      document.addEventListener('click', e => {
        if (!nav.contains(e.target) && !toggle.contains(e.target)) {
          nav.classList.remove('is-open');
          toggle.setAttribute('aria-expanded', 'false');
        }
      });
    </script>

    <script is:inline>
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(e => {
          if (e.isIntersecting) {
            e.target.classList.add('is-visible');
            observer.unobserve(e.target);
          }
        });
      }, { threshold: 0.12 });

      document.querySelectorAll('[data-animate], [data-animate-stagger]')
        .forEach(el => observer.observe(el));
    </script>
  </body>
</html>
