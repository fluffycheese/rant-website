---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title="Blog" description="Updates, release notes, and engineering notes from the RANT project.">
  <div class="section section--deep blog-hero">
    <div class="container">
      <span class="section-label">Blog</span>
      <h1>Updates from RANT</h1>
      <p style="font-size: 1.1rem; color: var(--text-secondary); margin-bottom: 0;">Release notes, engineering notes, and project updates.</p>
    </div>
  </div>

  <div class="section section--surface" style="padding-top: 3rem;">
    <div class="container">
      {posts.length === 0 ? (
        <p style="color: var(--text-muted);">No posts yet. Check back soon.</p>
      ) : (
        <div class="blog-list">
          {posts.map(post => (
            <article class="blog-list-item">
              <div class="blog-list-meta">
                {post.data.pubDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
                {post.data.author && ` · ${post.data.author}`}
              </div>
              <h2><a href={`/blog/${post.id}`}>{post.data.title}</a></h2>
              <p>{post.data.description}</p>
              <a href={`/blog/${post.id}`} class="blog-read-more">Read more →</a>
            </article>
          ))}
        </div>
      )}
    </div>
  </div>
</Layout>
